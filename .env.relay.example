# 推荐先沿用中转站的文字/识别通道；模板和导出本地完成，无需生图
AI_TEST_PROVIDER=relay
NEXT_PUBLIC_AI_TEST_PROVIDER=relay
CONFLUX_BASE_URL=https://oapi.kaitools.cn/v1
CONFLUX_API_KEY=请在服务器密钥配置中填写现有密钥
CONFLUX_REWRITE_MODEL=deepseek-v4.1-flash-1017
# 正常套模板不需要 COZE_API_TOKEN。
# 仅将来明确启用遗留 /api/illustrate 时，再按扣子目标环境配置认证。
# COZE_API_TOKEN=
# 禁止生产环境将文案保存到本机测试目录
AI_DEBUG_SAVE_RESULTS=0
ENABLE_LEGACY_AI_IMAGES=0
